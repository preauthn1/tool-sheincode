{
  "name": "fraudulent-order-processing/api",
  "description": "Fraudulent order processing API powered by ThinkPHP",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "aws/aws-sdk-php": "^3.386",
    "topthink/framework": "^6.1",
    "topthink/think-multi-app": "^1.0",
    "topthink/think-orm": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app/"
    }
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "scripts": {
    "post-autoload-dump": [
      "@php think service:discover",
      "@php think vendor:publish"
    ]
  }
}
